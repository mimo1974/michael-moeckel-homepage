---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Beruf">
	<div class="flex flex-col gap-12">
		<section>
			<h1 class="text-3xl font-heading font-semibold">Beruf</h1>
			<p class="mt-4 max-w-2xl text-muted-foreground">
				TODO: Kurze Bio – wer du bist und was du als Programmierer machst (2-4 Sätze).
			</p>
		</section>

		<section>
			<h2 class="text-xl font-heading font-semibold">Skills</h2>
			<ul class="mt-4 flex flex-wrap gap-2 text-sm text-muted-foreground">
				<li class="rounded-md border border-border px-2.5 py-1">TODO: Skill 1</li>
				<li class="rounded-md border border-border px-2.5 py-1">TODO: Skill 2</li>
				<li class="rounded-md border border-border px-2.5 py-1">TODO: Skill 3</li>
			</ul>
		</section>

		<section>
			<h2 class="text-xl font-heading font-semibold">Projekte</h2>
			<div class="mt-4 flex flex-col gap-4">
				<div class="rounded-lg border border-border p-4">
					<h3 class="font-medium">TODO: Projektname</h3>
					<p class="mt-1 text-sm text-muted-foreground">TODO: Ein bis zwei Sätze zum Projekt.</p>
				</div>
			</div>
		</section>

		<section>
			<h2 class="text-xl font-heading font-semibold">Kontakt</h2>
			<ul class="mt-4 flex flex-col gap-1 text-sm">
				<li>
					<a href="mailto:TODO@example.com" class="text-muted-foreground hover:text-foreground">
						TODO@example.com
					</a>
				</li>
				<li>
					<a href="https://linkedin.com/in/TODO" class="text-muted-foreground hover:text-foreground">
						LinkedIn
					</a>
				</li>
				<li>
					<a href="https://github.com/TODO" class="text-muted-foreground hover:text-foreground">
						GitHub
					</a>
				</li>
			</ul>
		</section>
	</div>
</Layout>
