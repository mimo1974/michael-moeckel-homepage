---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
---

<Layout title="Startseite">
	<div class="relative flex min-h-[60vh] flex-col justify-center gap-6">
		<h1 class="text-4xl font-heading font-semibold">Michael Möckel</h1>
		<p class="max-w-xl text-lg text-muted-foreground">
			Freelance Senior PHP Engineer & Architekt | Fokus: Laravel & moderne Web-Architekturen (Laravel/Symfony) | 20+ Jahre Erfahrung | Remote & Hybrid (Raum Chemnitz)
		</p>
		<p class="max-w-xl text-muted-foreground">Pragmatisch (KISS), Zielgerichtet, Kundenorientiert...</p>
		<div class="flex items-center gap-4 pt-2">
			<a href="/beruf" class={buttonVariants({ variant: 'default' })}>Beruf ansehen</a>
			<a
				href="/freizeit/astronomie"
				class="text-sm text-muted-foreground underline-offset-4 hover:underline"
			>
				Mehr über meine Freizeit →
			</a>
		</div>
	</div>
</Layout>
