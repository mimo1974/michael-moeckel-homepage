---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Starfield from '../components/Starfield.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Persönliche Website von Michael Möckel' } = Astro.props;
---

<!doctype html>
<html lang="de" class="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Michael Möckel</title>
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased">
		<Starfield />
		<SiteNav />
		<main class="mx-auto max-w-3xl px-6 py-12">
			<slot />
		</main>
		<footer class="border-t border-border">
			<div class="mx-auto flex max-w-3xl gap-6 px-6 py-6 text-sm text-muted-foreground">
				<a href="/impressum" class="hover:text-foreground">Impressum</a>
				<a href="/datenschutz" class="hover:text-foreground">Datenschutz</a>
			</div>
		</footer>
	</body>
</html>
