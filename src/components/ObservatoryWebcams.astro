---
const webcams = [
	{ filename: 'webcam1.jpg', alt: 'Livebild Sternwarte', span: true },
	{ filename: 'Capture.jpg', alt: 'All-Sky-Kamera', span: true },
	{ filename: 'dome.jpg', alt: 'Kuppel', span: true },
	{ filename: 'AAG_ImageCloudCondition.png', alt: 'Wolkenbedeckung', style: 'height: 140px' },
	{ filename: 'AAG_ImageRainCondition.png', alt: 'Regen', style: 'height: 140px' },
	{ filename: 'sqmleg.gif', alt: 'SQM-Verlauf (Himmelshelligkeit)' },
];
---

<section>
	<h2 class="text-xl font-heading font-semibold">Live von der Sternwarte</h2>
	<p class="mt-2 max-w-2xl text-sm text-muted-foreground">
		Live-Daten der Sternwarte in Jeßnigk, bereitgestellt vom AstroTeam Elbe-Elster e.V.
	</p>
	<div class="mt-4 grid gap-6 sm:grid-cols-2">
		{
			webcams.map((cam) => (
				<figure class:list={['rounded-lg border border-border p-3', { 'sm:col-span-2': cam.span }]}>
					<a href="http://elsterland-sternwarte.de" target="_blank" rel="noopener noreferrer">
						<img src={`/api/observatory/${cam.filename}`} alt={cam.alt} style={cam.style} class="w-full rounded-md" loading="eager" />
					</a>
					<figcaption class="mt-2 text-sm text-muted-foreground">{cam.alt}</figcaption>
				</figure>
			))
		}
	</div>
</section>
