---
// Deterministic PRNG so the star layout is stable across rebuilds.
function mulberry32(seed: number) {
	return function () {
		seed |= 0;
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const TILE_SIZE = 240;
const STAR_COUNT = 45;
const random = mulberry32(1974);

const stars = Array.from({ length: STAR_COUNT }, () => ({
	cx: Math.round(random() * TILE_SIZE),
	cy: Math.round(random() * TILE_SIZE),
	r: (random() * 0.8 + 0.3).toFixed(2),
	opacity: (random() * 0.6 + 0.3).toFixed(2),
}));

const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${TILE_SIZE}" height="${TILE_SIZE}">${stars
	.map((s) => `<circle cx="${s.cx}" cy="${s.cy}" r="${s.r}" fill="white" opacity="${s.opacity}"/>`)
	.join('')}</svg>`;

const backgroundImage = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
---

<div
	class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top,black,transparent_75%)]"
	style={{ backgroundImage, backgroundRepeat: 'repeat' }}
	aria-hidden="true"
>
</div>
