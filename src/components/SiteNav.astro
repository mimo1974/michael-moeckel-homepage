---
const navItems = [
	{ href: '/', label: 'Startseite' },
	{ href: '/beruf', label: 'Beruf' },
	{ href: '/freizeit/astronomie', label: 'Astronomie' },
	{ href: '/freizeit/sport', label: 'Sport' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-border">
	<nav class="mx-auto flex max-w-3xl items-center gap-6 px-6 py-4">
		{
			navItems.map((item) => (
				<a
					href={item.href}
					class:list={[
						'text-sm transition-colors hover:text-foreground',
						currentPath === item.href ? 'font-medium text-foreground' : 'text-muted-foreground',
					]}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>
